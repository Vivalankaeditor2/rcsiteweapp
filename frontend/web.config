<?xml version="1.0" encoding="utf-8"?>
<!--
  VivaLanka frontend on IIS (D-007).

  The frozen URL contract (D-003) requires that every legacy path keeps resolving
  at the SAME path with the SAME status - a 200 must never become a 301. This
  file only reverse-proxies; it deliberately adds NO trailing-slash, casing or
  canonicalising rewrite, because any of those would turn an indexed 200 into a
  301.

  Topology:
    browser -> IIS (this file) -> Next.js (:3000) for the app-owned paths
                              -> WildFly (:8080) for /api/* and the sitemaps

  Prerequisites on the IIS host (server-level, outside this file):
    * URL Rewrite module installed.
    * Application Request Routing (ARR) installed, with proxy enabled:
        appcmd set config -section:system.webServer/proxy /enabled:"True" /commit:apphost
    * The Node frontend running as a Windows service on http://127.0.0.1:3000
      (see DEPLOYMENT notes in AGENTS.md); WildFly 27 listening on :8080 with
      the RCWS_STANDALONE default port-offset (no offset).

  The two upstream ports are the only values to confirm per environment.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Read APIs are owned by the Spring Boot backend on WildFly. -->
        <rule name="Backend API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/api/{R:1}" />
        </rule>

        <!-- 2. Sitemaps are generated by the backend from the articles table
             (D-020, D-025). Keep the legacy index and shard names exactly. -->
        <rule name="Backend sitemap index" stopProcessing="true">
          <match url="^sitemapindex(04302022)?\.xml$" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:0}" />
        </rule>
        <rule name="Backend sitemap shard" stopProcessing="true">
          <match url="^sitemap_(\d+)\.xml$" />
          <action type="Rewrite" url="http://127.0.0.1:8080/sitemap_{R:1}.xml" />
        </rule>

        <!-- 3. Everything else (article, mobile, category, user and directory
             paths, /robots.txt and the Next assets) is served by Next.js at the
             exact requested path - the {R:1} passthrough is what preserves the
             URL. -->
        <rule name="Frontend Next.js" stopProcessing="true">
          <match url="^(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Keep the compression settings the legacy site relied on. -->
    <httpCompression>
      <dynamicTypes>
        <add mimeType="text/html" enabled="true" />
        <add mimeType="application/xml" enabled="true" />
      </dynamicTypes>
    </httpCompression>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
